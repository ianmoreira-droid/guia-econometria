. local g = 2

. forvalues h = 1/`g' {
  2.     quietly gen double a_lag`h' = a[_n-`h']
  3.     quietly gen double prod`h'  = a * a_lag`h'
  4.     quietly summarize prod`h'
  5.     scalar w`h'  = 1 - `h'/(`g'+1)
  6.     scalar nhat  = nhat + 2*w`h'*r(sum)
  7. }

. 
end of do-file

